API_HOST=0.0.0.0
API_PORT=8000

# Preferred: full decrypted SQL Server connection string
DB_CONNECTION_STRING=

# Alternative: build the connection string from parts
DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=yes

# Optional: if your app stores the SQL connection string encrypted
DB_CONNECTION_STRING_ENCRYPTED=
DB_ENCRYPTION_KEY=OnSearch-OnS3

# SAP B1 Service Layer
SAP_SL_BASE_URL=
SAP_SL_COMPANY_DB=
SAP_SL_USERNAME=
SAP_SL_PASSWORD=
SAP_SL_VERIFY_SSL=false
SAP_SL_TIMEOUT_SECONDS=30
# Optional: UDF field name in SAP document line to persist location (example: U_LocationCode)
SAP_SL_LOCATION_FIELD=
