API_HOST=0.0.0.0
API_PORT=8000
# Preferred: SHA-256 hash of each client API key, separated by comma.
API_KEY_HASHES=
# Development fallback only. Prefer API_KEY_HASHES outside local tests.
API_KEY=

# Preferred: full decrypted SQL Server connection string
DB_CONNECTION_STRING=

# Alternative: build the connection string from parts
DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=yes

# Optional: if your app stores the SQL connection string encrypted
DB_CONNECTION_STRING_ENCRYPTED=
DB_ENCRYPTION_KEY=OnSearch-OnS3

# SAP B1 Service Layer
SAP_SL_BASE_URL=
SAP_SL_COMPANY_DB=
SAP_SL_USERNAME=
SAP_SL_PASSWORD=
SAP_SL_VERIFY_SSL=false
SAP_SL_TIMEOUT_SECONDS=30
# Optional: UDF field name in SAP document line to persist location (example: U_LocationCode)
SAP_SL_LOCATION_FIELD=

# Sales summary email
SALES_DB_CONNECTION_STRING=
SALES_DB_HOST=
SALES_DB_NAME=
SALES_DB_USER=
SALES_DB_PASSWORD=
SALES_DB_DRIVER=ODBC Driver 17 for SQL Server
SALES_DB_TRUST_SERVER_CERTIFICATE=yes
SALES_EMAIL_SMTP_SERVER=smtp.gmail.com
SALES_EMAIL_SMTP_PORT=587
SALES_EMAIL_SENDER=
SALES_EMAIL_PASSWORD=
SALES_EMAIL_RECIPIENTS=
SALES_EMAIL_SUBJECT_PREFIX=Resumo de Vendas

# Sales summary MA email
SALES_MA_EMAIL_SMTP_SERVER=smtp.gmail.com
SALES_MA_EMAIL_SMTP_PORT=587
SALES_MA_EMAIL_SENDER=
SALES_MA_EMAIL_PASSWORD=
SALES_MA_EMAIL_RECIPIENTS=
SALES_MA_EMAIL_SUBJECT_PREFIX=Resumo de Vendas
